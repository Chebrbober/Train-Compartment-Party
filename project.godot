; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Train Compartment Party"
run/main_scene="uid://bj1cx8mf3t2pb"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="uid://chv7np8s2h3xb"

[autoload]

TransitionScene="*uid://iqqykrc8rs0j"
InteractManager="*uid://b11qua7f71ehy"
GameEvents="*uid://c3jm3ay6vcf34"

[display]

window/size/viewport_width=640
window/size/viewport_height=380
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="New Game Project"

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://autoload/": "gray",
"res://resources/": "purple",
"res://scenes/": "orange",
"res://scripts/": "blue",
"res://ui/": "teal"
}

